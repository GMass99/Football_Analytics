def get_top_stat_round(prev_fix_stats, stat, players, teams, stats_types):
    stat_id = stats_types[stats_types['name'] == stat]['id'].values[0]
    prev_fix_stats = prev_fix_stats[prev_fix_stats['stats_type_id'] == stat_id]
    if prev_fix_stats.empty:
        return []
    prev_fix_stats = prev_fix_stats.copy()
    prev_fix_stats.sort_values(by=['value'], ascending=False, inplace=True)
    results = []
    for _, row in prev_fix_stats.iterrows():
        if len(results) == 10:
            break
        try:
            player_id = row['player_id']
            player_name = players[players['id'] == player_id]['display_name'].values[0]
            team_id = row['team_id']
            team_name = teams[teams['id'] == team_id]['name'].values[0]
            stat_value = row['value']
            results.append((player_name, team_name, stat_value))
        except:
            pass
    return pd.DataFrame(results, columns=['Player', 'Team', stat])

get_top_stat_round(prev_fix_stats, 'Shots Total', players, teams, stats_types)
